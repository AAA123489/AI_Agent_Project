API_KEY=your_api_key_here
API_URL=https://api.deepseek.com/anthropic/v1/messages
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.3
# 回答长度上限（tokens）：上限而非目标。消融实验改这个值
MAX_TOKENS=1000
# 向量检索返回片段数（top_k）。消融最优：8
TOP_K=8
# 检索模式：hybrid（向量+BM25 RRF 融合，默认）| vector（纯向量，消融对照）
RETRIEVAL_MODE=hybrid
# 「最近/近来/近期」的默认时间窗（天）。这些词没有确定所指，统一按「最近 N 天」处理；
# 问「最近三天」这类带明确数字的仍按数字走，不受此值影响。
RECENT_WINDOW_DAYS=30
# 召回自检（手写判定循环）：判定召回的片段能否支撑回答，不能则拒答而非编造。
# on = 启用 | off = 改造前行为（直接返回检索结果）。实测 on 时硬负例拒答 0/6 → 6/6、正例零误拒
RECALL_GUARD=off
# 自检检索轮数：1 = 不重检（默认，消融结论：环无收益且有反效果）| 2 = 允许一次改写重检（环跑一圈）
RECALL_GUARD_MAX_ATTEMPTS=1
# 对话日志分文件标签（消融实验）：改分块参数后记得同步改这里，如 chunk300_overlap50
EXPERIMENT_TAG=baseline
REDIS_URL=redis://localhost:6379
# 查询级缓存：相同问题直接复用上次答案（省 DeepSeek 调用 + 检索，命中秒回）。on | off
QUERY_CACHE=on
# 缓存过期秒数（默认 1 小时；知识库更新后可调短，如 600）
QUERY_CACHE_TTL=3600
# ── 定时自动更新知识库 ──
# 服务运行期间每天按下面时刻自动跑一次增量爬取 → 入库 → 清查询缓存。
# 爬虫是 URL 级去重的（campus_scraper/storage.py），重复跑不会重复入库，只捞新增文章。
SCRAPE_SCHEDULE_ENABLED=on
# 触发时刻（24 小时制，本地时间）
SCRAPE_SCHEDULE_HOUR=10
SCRAPE_SCHEDULE_MINUTE=0
# 日常定时每类最多爬几页。**这是上限而非固定成本**：爬虫遇到已爬过的 URL 就停止
# 翻页，所以日常实际只翻 1 页。列表页一页约 18 篇、覆盖约 6 个月，1 页足够。
SCRAPE_SCHEDULE_PAGES=1
# 启动补跑每类最多爬几页。补跑对应「停摆很久后追赶」，需要更深，故单独配一个大值。
# 同样受「遇到已爬内容即停」约束，所以平时不会跑满；跑满时每页间休息 3~8 分钟。
SCRAPE_CATCHUP_PAGES=3
# 启动补跑阈值（天）：距上次成功爬取超过这么多天，启动后立刻补跑一次；0 = 关闭。
# 服务不常驻时，凌晨窗口往往在关机状态，靠这个才能真正闭环。
SCRAPE_CATCHUP_DAYS=3

# ── 账号 / 会话 ──
# 会话签名密钥。**部署前必须设置成随机长字符串**；留空会每次启动随机生成，
# 后果是服务一重启所有用户都要重新登录。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 登录 Cookie 有效期（秒），默认 7 天
SESSION_TTL_SECONDS=604800
# Cookie Secure 属性：auto = 跟随请求协议 / X-Forwarded-Proto | true | false
# 本地 HTTP 调试用 auto 即可；ngrok 的 HTTPS 会自动带 Secure
COOKIE_SECURE=auto
# 密码最短长度（注册时校验）
MIN_PASSWORD_LEN=8
# bcrypt 计算轮数，越高越慢越安全；默认 12
BCRYPT_ROUNDS=12
# 每账号每日提问上限（含缓存命中）；0 = 不限制
DAILY_MESSAGE_QUOTA=50
# 注册邀请码：留空 = 任何人可注册；填写后注册必须提供该码（链接被转发时用来控量）
REGISTER_INVITE_CODE=
# 账号 / 额度 / 问答审计数据库路径；相对路径按 rag_chat/ 解析
APP_DB_PATH=data/rag_app.db
# 问答审计保留天数：启动时与之后每 24 小时删除超过该天数的记录；0 = 永久保留
AUDIT_RETENTION_DAYS=90
