API_KEY=your_api_key_here
API_URL=https://api.deepseek.com/anthropic/v1/messages
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.3
# 回答长度上限（tokens）：上限而非目标。消融实验改这个值
MAX_TOKENS=1000
# 向量检索返回片段数（top_k）。消融最优：8
TOP_K=8
# 检索模式：hybrid（向量+BM25 RRF 融合，默认）| vector（纯向量，消融对照）
RETRIEVAL_MODE=hybrid
# 重排开关：on 时对融合后候选用 CrossEncoder 精排再截断（需下载 ~440MB 模型，bge-reranker-base）| off
RETRIEVAL_RERANK=off
# 重排候选数：重排后保留多少条进 LLM 上下文。消融建议 ≥16（N=8 会截掉宽泛题关键句）
RERANK_TOP_N=16
# 对话日志分文件标签（消融实验）：改分块参数后记得同步改这里，如 chunk300_overlap50
EXPERIMENT_TAG=baseline
REDIS_URL=redis://localhost:6379
