API_KEY=your_api_key_here
API_URL=https://api.deepseek.com/anthropic/v1/messages
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.3
# 回答长度上限（tokens）：上限而非目标。消融实验改这个值
MAX_TOKENS=1000
# 向量检索返回片段数（top_k）。消融最优：8
TOP_K=8
# 检索模式：hybrid（向量+BM25 RRF 融合，默认）| vector（纯向量，消融对照）
RETRIEVAL_MODE=hybrid
# 召回自检（手写判定循环）：判定召回的片段能否支撑回答，不能则拒答而非编造。
# on = 启用 | off = 改造前行为（直接返回检索结果）。实测 on 时硬负例拒答 0/6 → 6/6、正例零误拒
RECALL_GUARD=off
# 自检检索轮数：1 = 不重检（默认，消融结论：环无收益且有反效果）| 2 = 允许一次改写重检（环跑一圈）
RECALL_GUARD_MAX_ATTEMPTS=1
# 对话日志分文件标签（消融实验）：改分块参数后记得同步改这里，如 chunk300_overlap50
EXPERIMENT_TAG=baseline
REDIS_URL=redis://localhost:6379
# 查询级缓存：相同问题直接复用上次答案（省 DeepSeek 调用 + 检索，命中秒回）。on | off
QUERY_CACHE=on
# 缓存过期秒数（默认 1 小时；知识库更新后可调短，如 600）
QUERY_CACHE_TTL=3600
# ── 定时自动更新知识库 ──
# 服务运行期间每天按下面时刻自动跑一次增量爬取 → 入库 → 清查询缓存。
# 爬虫是 URL 级去重的（campus_scraper/storage.py），重复跑不会重复入库，只捞新增文章。
SCRAPE_SCHEDULE_ENABLED=on
# 触发时刻（24 小时制，本地时间）
SCRAPE_SCHEDULE_HOUR=3
SCRAPE_SCHEDULE_MINUTE=0
# 每类爬几页。增量场景 2 页够用（新文章都在列表头部）。
# 注意代价：每页之间要休息 3~8 分钟（模拟真人、避免触发官网防火墙），
# 13 分类 × 2 页 ≈ 2 小时。调大请自行估算耗时。
SCRAPE_SCHEDULE_PAGES=2
# 启动补跑阈值（天）：距上次成功爬取超过这么多天，启动后立刻补跑一次；0 = 关闭。
# 服务不常驻时，凌晨窗口往往在关机状态，靠这个才能真正闭环。
SCRAPE_CATCHUP_DAYS=3
