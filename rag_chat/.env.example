API_KEY=your_api_key_here
API_URL=https://api.deepseek.com/anthropic/v1/messages
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.3
# 回答长度上限（tokens）：上限而非目标。消融实验改这个值
MAX_TOKENS=1000
# 向量检索返回片段数（top_k）。消融最优：8
TOP_K=8
# 检索模式：hybrid（向量+BM25 RRF 融合，默认）| vector（纯向量，消融对照）
RETRIEVAL_MODE=hybrid
# 重排开关：on 时对融合后候选用 CrossEncoder 精排再截断（需下载 ~440MB 模型，bge-reranker-base）| off
RETRIEVAL_RERANK=off
# 重排候选数：重排后保留多少条进 LLM 上下文。消融建议 ≥16（N=8 会截掉宽泛题关键句）
RERANK_TOP_N=16
# 召回自检（LangGraph 状态机）：判定召回的片段能否支撑回答，不能则拒答而非编造。
# on = 启用 | off = 改造前行为（直接返回检索结果）。实测 on 时硬负例拒答 0/6 → 6/6、正例零误拒
RECALL_GUARD=off
# 自检图检索轮数：1 = 不重检（默认，消融结论：环无收益且有反效果）| 2 = 允许一次改写重检（环跑一圈）
RECALL_GUARD_MAX_ATTEMPTS=1
# Agent 主循环（LangGraph 状态机，src/agent_graph.py）：
# on = 走状态图 | off = 原手写 for-step 循环（默认）。两条路径行为对齐，开关只为灰度与对照
AGENT_GRAPH=off
# 对话日志分文件标签（消融实验）：改分块参数后记得同步改这里，如 chunk300_overlap50
EXPERIMENT_TAG=baseline
REDIS_URL=redis://localhost:6379
# 查询级缓存：相同问题直接复用上次答案（省 DeepSeek 调用 + 检索，命中秒回）。on | off
QUERY_CACHE=on
# 缓存过期秒数（默认 1 小时；知识库更新后可调短，如 600）
QUERY_CACHE_TTL=3600
