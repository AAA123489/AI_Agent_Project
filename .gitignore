# 虚拟环境文件夹
.venv/

# 密钥配置文件
.env

# 日志文件
*.log
app.log

# Python缓存垃圾文件
__pycache__/
*.pyc

# Chroma 向量数据库
chroma_db/

# SQLite 数据库文件
*.db
*.sqlite3
*.db-shm
*.db-wal

# 工具缓存
.ruff_cache/
.pytest_cache/

# 聊天日志（含真实对话内容）
chat_logs*.txt

# 爬虫抓取的文档数据（可再生，不入库）
scraped_docs/

# 外网穿透工具二进制
ngrok.exe

# 个人文件（简历 / 面试笔记，不入库）
/zzs.pdf
/会话管理.md
/模拟面试答案详解.txt
/项目三面试详解.txt